@page "/clients"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Mvc.Rendering

@inject ClientApiService ClientApi
@inject NavigationManager Nav


<PageTitle>Clients — GLMS</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">Clients</h1>
        <p class="page-subtitle">Manage TechMove client accounts</p>
    </div>
    <button class="btn btn-primary" @onclick="() => _showForm = !_showForm">
        <i class="fa-solid @(_showForm ? "fa-xmark" : "fa-plus")"></i>
        @(_showForm ? "Cancel" : "Add Client")
    </button>
</div>

@if (!string.IsNullOrEmpty(_successMsg))
{
    <div class="alert alert-success"><i class="fa-solid fa-check-circle"></i> @_successMsg</div>
}

@if (_showForm)
{
    <div class="card" style="margin-bottom:24px">
        <div class="card-header"><span class="card-title">New Client</span></div>
        <div class="card-body">
            <EditForm Model="_newClient" OnValidSubmit="SaveClientAsync">
                <DataAnnotationsValidator />
                <div class="form-grid">
                    <div class="form-group">
                        <label>Company Name *</label>
                        <InputText class="form-control" @bind-Value="_newClient.Name" placeholder="Oceanic Freight Ltd" />
                        <ValidationMessage For="() => _newClient.Name" class="form-error" />
                    </div>
                    <div class="form-group">
                        <label>Region *</label>
                        <InputSelect class="form-control" @bind-Value="_newClient.Region">
                            <option value="">— Select Region —</option>
                            <option>Africa</option>
                            <option>Europe</option>
                            <option>Asia-Pacific</option>
                            <option>North America</option>
                            <option>South America</option>
                            <option>Middle East</option>
                        </InputSelect>
                        <ValidationMessage For="() => _newClient.Region" class="form-error" />
                    </div>
                    <div class="form-group full-width">
                        <label>Contact Details *</label>
                        <InputTextArea class="form-control" rows="2" @bind-Value="_newClient.ContactDetails" placeholder="email, phone, address…" />
                        <ValidationMessage For="() => _newClient.ContactDetails" class="form-error" />
                    </div>
                </div>
                <div style="margin-top:20px; display:flex; gap:10px">
                    <button type="submit" class="btn btn-primary" disabled="@_saving">
                        @if (_saving)
                        {
                            <span>Saving…</span>
                        }
                        else
                        {

                            <span><i class="fa-solid fa-floppy-disk"></i> Save Client</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<div class="card">
    <div class="card-header"><span class="card-title">All Clients (@_clients.Count)</span></div>
    @if (_clients.Any())
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Region</th>
                    <th>Contact</th>
                    <th>Contracts</th>
                    <th>Joined</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in _clients)
                {
                    <tr>
                        <td><span style="color:var(--text-muted)">#@c.Id</span></td>
                        <td><strong>@c.Name</strong></td>
                        <td>@c.Region</td>
                        <td style="color:var(--text-muted);font-size:13px">@c.ContactDetails</td>
                        <td>@c.Contracts?.Count ?? 0</td>
                        <td style="color:var(--text-muted)">@c.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td>
                            <button class="btn btn-ghost btn-sm" @onclick="() => EditClient(c)"><i class="fa-solid fa-pen"></i></button>
                            <button class="btn btn-danger btn-sm" @onclick="() => ConfirmDeleteClient(c)"><i class="fa-solid fa-trash"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <i class="fa-solid fa-building-user"></i>
            <h3>No Clients Yet</h3>
            <p>Add your first client using the button above.</p>
        </div>
    }
</div>

<!-- Edit Modal -->
@if (_editingClient != null)
{
    <div class="modal show" style="display:block;">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Client</h5>
                    <button type="button" class="btn-close" @onclick="CancelEdit"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="_editingClient" OnValidSubmit="UpdateClientAsync">
                        <DataAnnotationsValidator />
                        <div class="form-group">
                            <label>Company Name *</label>
                            <InputText class="form-control" @bind-Value="_editingClient.Name" />
                            <ValidationMessage For="() => _editingClient.Name" class="form-error" />
                        </div>
                        <div class="form-group">
                            <label>Region *</label>
                            <InputSelect class="form-control" @bind-Value="_editingClient.Region">
                                <option value="">— Select Region —</option>
                                @* ... options ... *@
                            </InputSelect>
                            <ValidationMessage For="() => _editingClient.Region" class="form-error" />
                        </div>
                        <div class="form-group">
                            <label>Contact Details *</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="_editingClient.ContactDetails" />
                            <ValidationMessage For="() => _editingClient.ContactDetails" class="form-error" />
                        </div>
                        <div style="margin-top:20px; display:flex; gap:10px">
                            <button type="submit" class="btn btn-primary" disabled="@_saving">Save Changes</button>
                            <button type="button" class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation -->
@if (_deleteClient != null)
{
    <div class="modal show" style="display:block;">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Delete Client</h5>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete <strong>@_deleteClient.Name</strong>?</p>
                    <div style="margin-top:20px; display:flex; gap:10px">
                        <button class="btn btn-danger" @onclick="DeleteClientAsync">Delete</button>
                        <button class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Client> _clients = new();
    private Client _newClient = new();
    private bool _showForm, _saving;
    private string _successMsg = "";
    private Client? _editingClient;
    private Client? _deleteClient;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _clients = await ClientApi.GetAllClientsAsync();
    }

    private async Task SaveClientAsync()
    {
        _saving = true;
        _newClient.CreatedAt = DateTime.UtcNow;

        try
        {
            await ClientApi.CreateClientAsync(_newClient);
            _successMsg = $"Client '{_newClient.Name}' created successfully.";
            _newClient = new();
            _showForm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _successMsg = $"Error: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private void EditClient(Client client)
    {
        _editingClient = new Client
        {
            Id = client.Id,
            Name = client.Name,
            Region = client.Region,
            ContactDetails = client.ContactDetails,
            CreatedAt = client.CreatedAt
        };
    }

    private void CancelEdit() => _editingClient = null;

    private async Task UpdateClientAsync()
    {
        if (_editingClient == null) return;

        _saving = true;
        try
        {
            await ClientApi.UpdateClientAsync(_editingClient);
            _successMsg = $"Client '{_editingClient.Name}' updated successfully.";
            _editingClient = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _successMsg = $"Error: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private void ConfirmDeleteClient(Client client) => _deleteClient = client;
    private void CancelDelete() => _deleteClient = null;

    private async Task DeleteClientAsync()
    {
        if (_deleteClient == null) return;

        _saving = true;
        try
        {
            await ClientApi.DeleteClientAsync(_deleteClient.Id);
            _successMsg = $"Client '{_deleteClient.Name}' deleted.";
            _deleteClient = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _successMsg = $"Error: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }
}